# ============================================
# HAUSELIO — Umgebungsvariablen
# ============================================
# Diese Datei als .env.local kopieren und Werte eintragen
# ODER direkt in Vercel > Settings > Environment Variables konfigurieren
# ============================================

# --- ERFORDERLICH (Required) ---

# Datenbank (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.PROJECT_ID:[PASSWORT]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth JWT Secret (>=32 Zeichen, generieren)
JWT_SECRET=""

# --- CLOUDINARY (Bilder-Upload) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- RESEND (Transaktions-E-Mails) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HAUSELIO <info@hauselio.de>"

# --- ALGOLIA (Suche) ---
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_ADMIN_API_KEY=""

# --- UPSTASH REDIS (Rate LimitingProduktion) ---
# https://upstash.com > Console
# Erforderlich für effizientes Rate Limiting in Serverless
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- SENTRY (Error Tracking) ---
# Optional: Fehler-Monitoring in Produktion
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- SEITE ---
NEXT_PUBLIC_SITE_URL="https://hauselio.vercel.app"
NEXT_PUBLIC_SITE_NAME="HAUSELIO"

# --- SEED SCRIPT ---
# Erforderlich für prisma/seed.ts (npm run seed)
ADMIN_PASSWORD=""
