# ============================================
# HAUSAURA — Environment Variables
# ============================================
# Copier ce fichier en .env et remplir les valeurs
# Ou les configurer dans Vercel > Settings > Environment Variables
# ============================================

# --- REQUIS (Required) ---

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth JWT Secret (>=32 chars, généré aléatoirement)
JWT_SECRET="your-random-secret-min-32-chars"

# --- CLOUDINARY (Upload d'images) ---
# https://console.cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- RESEND (Emails transactionnels) ---
# https://resend.com > API Keys
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="HAUSAURA <info@hausaura.de>"

# --- ALGOLIA (Recherche) ---
# https://algolia.com > Credentials
ALGOLIA_APP_ID="your_app_id"
ALGOLIA_SEARCH_API_KEY="your_search_api_key"
ALGOLIA_ADMIN_API_KEY="your_admin_api_key"

# --- UPSTASH REDIS (Rate Limiting production - optionnel) ---
# https://upstash.com > Console
# UPSTASH_REDIS_REST_URL="https://your-upstash-url"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# --- SITE ---
NEXT_PUBLIC_SITE_URL="https://www.hausaura.de"
NEXT_PUBLIC_SITE_NAME="HAUSAURA"

# --- ADMIN ---
# Mot de passe admin (uniquement pour le dev local)
ADMIN_PASSWORD="your_admin_password"
