# ============================================
# HAUSELIO — Environment Variables
# ============================================
# Copier ce fichier en .env et remplir les valeurs
# OU configurer directement dans Vercel > Settings > Environment Variables
# ============================================

# --- REQUIS (Required) ---

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.PROJECT_ID:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth JWT Secret (>=32 chars, généré)
JWT_SECRET=""

# --- CLOUDINARY (Upload d'images) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- RESEND (Emails transactionnels) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HAUSELIO <info@hauselio.de>"

# --- ALGOLIA (Recherche) ---
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_ADMIN_API_KEY=""

# --- UPSTASH REDIS (Rate Limiting production) ---
# https://upstash.com > Console
# Requis pour le rate limiting efficace en serverless
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- SITE ---
NEXT_PUBLIC_SITE_URL="https://hauselio.vercel.app"
NEXT_PUBLIC_SITE_NAME="HAUSELIO"
