<!DOCTYPE html>
<html lang="en-US" data-scheme="light">
<head>
    <script>
      (() => {
        const scheme = document.cookie.match(/scheme=([^;]+)/)?.[1] ?? 'light';
        document.documentElement.dataset.scheme = scheme;

        document.addEventListener('DOMContentLoaded', function() {
          const toggle = document.getElementById('dark-mode-toggle');
          const text = document.querySelector('.theme__trigger-text');
          if (toggle) toggle.checked = scheme === 'dark';
          if (text) text.textContent = scheme === 'dark' ? text.dataset.labelDark : text.dataset.labelLight;
        });
      })();
    </script>
