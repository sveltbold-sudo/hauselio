    <!-- 0. Early consent check (synchronous, pre-paint) -->
<script>
  (function () {
    try {
      var match = document.cookie.match(/OptanonConsent=([^;]+)/);
      if (!match) return;
      var groups = decodeURIComponent(match[1]).match(/groups=([^&]*)/);
      if (!groups) return;
      if (groups[1].split(',').indexOf('C0004:1') !== -1) {
        document.documentElement.classList.add('has-yt-consent');
      }
    } catch (e) {}
  })();
</script>

<!-- 1. Consent Mode Defaults -->
<script>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied'
  });
</script>

<!-- 2. OneTrust Cookie Consent Script -->
<script src="https://cdn.cookielaw.org/scripttemplates/otSDKStub.js"
        type="text/javascript"
        charset="UTF-8"
        data-domain-script="04cd632e-4a7e-408b-ad8f-a08f0165953f"
        data-document-language="true"></script>

<!-- 3. OneTrust Callback: Load GTM only after consent -->
<script type="text/javascript">
  function OptanonWrapper() {
    if (OnetrustActiveGroups.indexOf('C0004') > -1) {
      gtag('consent', 'update', {'analytics_storage': 'granted'});

      // Load GTM only after consent
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://tag.vorwerk.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-W3LNQC5G');
    }

    // Notify other components (e.g. video player) about consent changes
    window.dispatchEvent(new Event('consentUpdated'));
  }
</script>

<!-- 4. GTM noscript (directly after <body>) -->
<noscript>
